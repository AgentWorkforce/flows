{
  "name": "@relayflows/surface",
  "version": "2.0.8",
  "description": "TypeScript authoring surface for Relayflows.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "bun run build",
    "typecheck": "tsc --noEmit",
    "typecheck:regressions": "tsc -p ../../regressions/tsconfig.json",
    "typecheck:examples": "tsc -p ../../examples/tsconfig.json",
    "test": "bun run build && tsc -p tsconfig.test.json && vitest run"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentWorkforce/flows.git",
    "directory": "packages/surface"
  },
  "peerDependencies": {
    "@relayfile/relay-helpers": "0.4.11"
  }
}
