{
  "schemaVersion": 1,
  "kind": "relayflows-eval",
  "id": "relayflows-durability-v1",
  "defaultRepetitions": 30,
  "minimumPublishableRepetitions": 30,
  "environmentFailurePatterns": [
    "CARGO_NOT_FOUND",
    "CARGO_BOOTSTRAP_FAILED",
    "BENCHMARK_ENVIRONMENT_FAILURE",
    "failed to download",
    "Could not resolve host",
    "No space left on device"
  ],
  "cases": [
    {
      "id": "black-box-cli-sigkill-resume",
      "claim": "An external caller can SIGKILL the CLI after one completed step while the next is in flight, then resume without replaying completed work while replacing the unfinished attempt.",
      "command": {
        "file": "node",
        "args": ["black-box-crash.mjs"],
        "cwd": ".",
        "timeoutMs": 150000
      },
      "successWitnesses": [
        {"stream": "stdout", "contains": "BLACK_BOX_ASSERTIONS: 16/16"},
        {"stream": "stdout", "contains": "\"completionReason\":\"success\""},
        {"stream": "stdout", "contains": "\"attempts\":2"},
        {"stream": "stdout", "contains": "\"effects\":[\"first\",\"second\",\"third\"]"}
      ]
    },
    {
      "id": "deterministic-boundary-resume",
      "claim": "A deterministic three-step flow survives a kill at every boundary without replaying a completed effect.",
      "command": {
        "file": "../ops/cargo.sh",
        "args": ["test", "-p", "relayflowd", "--test", "crash_resume", "sigkill_sweep_covers_every_hello_step_boundary", "--", "--exact", "--nocapture", "--test-threads=1"],
        "cwd": "../../kernel",
        "timeoutMs": 120000
      },
      "successWitnesses": [
        {"stream": "stdout", "contains": "test sigkill_sweep_covers_every_hello_step_boundary ... ok"},
        {"stream": "stdout", "contains": "test result: ok. 1 passed; 0 failed"}
      ]
    },
    {
      "id": "llm-result-memoization",
      "claim": "A completed llm result and its budget are reused after the server dies during the following step.",
      "command": {
        "file": "../ops/cargo.sh",
        "args": ["test", "-p", "relayflowd", "--test", "crash_resume", "llm::completed_llm_output_is_memoized_when_serve_dies_during_the_next_step", "--", "--exact", "--nocapture", "--test-threads=1"],
        "cwd": "../../kernel",
        "timeoutMs": 120000
      },
      "successWitnesses": [
        {"stream": "stdout", "contains": "test llm::completed_llm_output_is_memoized_when_serve_dies_during_the_next_step ... ok"},
        {"stream": "stdout", "contains": "test result: ok. 1 passed; 0 failed"}
      ]
    },
    {
      "id": "agent-effect-exactly-once",
      "claim": "A crash between effect election and provider invocation produces exactly one declared external effect.",
      "command": {
        "file": "../ops/cargo.sh",
        "args": ["test", "-p", "relayflowd", "--test", "crash_resume", "agent::rung_c_crash_between_effect_election_and_the_provider_call_performs_it_exactly_once", "--", "--exact", "--nocapture", "--test-threads=1"],
        "cwd": "../../kernel",
        "timeoutMs": 120000
      },
      "successWitnesses": [
        {"stream": "stdout", "contains": "test agent::rung_c_crash_between_effect_election_and_the_provider_call_performs_it_exactly_once ... ok"},
        {"stream": "stdout", "contains": "test result: ok. 1 passed; 0 failed"}
      ]
    },
    {
      "id": "durable-channel-redelivery",
      "claim": "An unacknowledged channel message is redelivered after SIGKILL while its external effect remains exactly once.",
      "command": {
        "file": "../ops/cargo.sh",
        "args": ["test", "-p", "relayflowd", "--test", "crash_resume", "channels::channels_sigkill_resume_redelivers_unacked_messages_with_exactly_once_effects", "--", "--exact", "--nocapture", "--test-threads=1"],
        "cwd": "../../kernel",
        "timeoutMs": 120000
      },
      "successWitnesses": [
        {"stream": "stdout", "contains": "test channels::channels_sigkill_resume_redelivers_unacked_messages_with_exactly_once_effects ... ok"},
        {"stream": "stdout", "contains": "test result: ok. 1 passed; 0 failed"}
      ]
    },
    {
      "id": "concurrent-resume-single-lease",
      "claim": "Concurrent resume requests lease exactly one replacement attempt.",
      "command": {
        "file": "../ops/cargo.sh",
        "args": ["test", "-p", "relayflowd", "--test", "crash_resume", "concurrency::concurrent_resumes_lease_exactly_one_attempt", "--", "--exact", "--nocapture", "--test-threads=1"],
        "cwd": "../../kernel",
        "timeoutMs": 120000
      },
      "successWitnesses": [
        {"stream": "stdout", "contains": "test concurrency::concurrent_resumes_lease_exactly_one_attempt ... ok"},
        {"stream": "stdout", "contains": "test result: ok. 1 passed; 0 failed"}
      ]
    },
    {
      "id": "memory-budget-once",
      "claim": "A crash after memory injection reuses the journaled pack and charges its tokens exactly once.",
      "command": {
        "file": "../ops/cargo.sh",
        "args": ["test", "-p", "relayflowd", "--test", "crash_resume", "memory::memory_sigkill_after_injection_replays_pack_and_charges_it_once", "--", "--exact", "--nocapture", "--test-threads=1"],
        "cwd": "../../kernel",
        "timeoutMs": 120000
      },
      "successWitnesses": [
        {"stream": "stdout", "contains": "test memory::memory_sigkill_after_injection_replays_pack_and_charges_it_once ... ok"},
        {"stream": "stdout", "contains": "test result: ok. 1 passed; 0 failed"}
      ]
    }
  ]
}
