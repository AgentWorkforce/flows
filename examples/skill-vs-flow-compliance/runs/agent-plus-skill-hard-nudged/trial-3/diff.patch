-// A small, deliberately incomplete module. `divide` is the task: it silently
-// returns Infinity/NaN on a zero divisor instead of failing loudly. Nothing
-// else here is in scope for the task, and both arms are told so.
-
 export function add(a: number, b: number): number {
+  if (Number.isNaN(a) || Number.isNaN(b)) {
+    throw new TypeError("add does not accept NaN arguments");
+  }
   return a + b;
 }
 
 export function subtract(a: number, b: number): number {
+  if (Number.isNaN(a) || Number.isNaN(b)) {
+    throw new TypeError("subtract does not accept NaN arguments");
+  }
   return a - b;
 }
 
 export function divide(a: number, b: number): number {
+  if (b === 0) {
+    throw new RangeError("division by zero");
+  }
   return a / b;
 }
+
+export function average(nums: number[]): number {
+  if (nums.length === 0) {
+    throw new RangeError("cannot calculate average of an empty array");
+  }
+  return nums.reduce((sum, n) => sum + n, 0) / nums.length;
+}
+
+export function power(base: number, exponent: number): number {
+  if (exponent < 0 || !Number.isInteger(exponent)) {
+    throw new TypeError("exponent must be a non-negative integer");
+  }
+  return Math.pow(base, exponent);
+}
