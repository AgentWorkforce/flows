 });
 
+test("add throws TypeError on NaN first argument", () => {
+  assert.throws(() => add(NaN, 3), TypeError);
+});
+
+test("add throws TypeError on NaN second argument", () => {
+  assert.throws(() => add(2, NaN), TypeError);
+});
+
 test("subtract", () => {
   assert.equal(subtract(5, 3), 2);
 });
 
+test("subtract throws TypeError on NaN first argument", () => {
+  assert.throws(() => subtract(NaN, 3), TypeError);
+});
+
+test("subtract throws TypeError on NaN second argument", () => {
+  assert.throws(() => subtract(5, NaN), TypeError);
+});
+
 test("divide", () => {
   assert.equal(divide(6, 3), 2);
 });
 
-// Deliberately absent: a case for dividing by zero. That is the gap the
-// task asks either arm to close.
+test("divide throws RangeError on zero divisor", () => {
+  assert.throws(() => divide(1, 0), RangeError);
+});
+
+test("average calculates arithmetic mean", () => {
+  assert.equal(average([2, 4, 6]), 4);
+  assert.equal(average([10]), 10);
+  assert.equal(average([1, 2, 3, 4, 5]), 3);
+});
+
