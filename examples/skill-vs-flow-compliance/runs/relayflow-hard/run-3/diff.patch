@@ -3,13 +3,39 @@
 // else here is in scope for the task, and both arms are told so.
 
 export function add(a: number, b: number): number {
+  if (Number.isNaN(a) || Number.isNaN(b)) {
+    throw new TypeError('add requires valid numbers, not NaN');
+  }
   return a + b;
 }
 
 export function subtract(a: number, b: number): number {
+  if (Number.isNaN(a) || Number.isNaN(b)) {
+    throw new TypeError('subtract requires valid numbers, not NaN');
+  }
   return a - b;
 }
 
 export function divide(a: number, b: number): number {
+  if (b === 0) {
+    throw new RangeError('cannot divide by zero');
+  }
   return a / b;
 }
+
+export function average(nums: number[]): number {
+  if (nums.length === 0) {
+    throw new RangeError('cannot take average of empty array');
+  }
+  return nums.reduce((sum, num) => sum + num, 0) / nums.length;
+}
+
+export function power(base: number, exponent: number): number {
+  if (!Number.isInteger(exponent)) {
+    throw new TypeError('exponent must be an integer');
+  }
+  if (exponent < 0) {
+    throw new TypeError('exponent must be non-negative');
+  }
+  return Math.pow(base, exponent);
+}
